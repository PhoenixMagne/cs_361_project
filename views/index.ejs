<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baking Organizer - My Collection</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <div class="header-left">
      <button id="timerMenuBtn" class="timerMenuBtn">+ Timers</button>
      
      <div id="timerDropdown" class="timer-window hidden">
        <h3>Quick Timer</h3>
        <div class="timer-input-group">
          <input type="number" id="timerMins" placeholder="Min" min="0" style="width: 50px;">
          <span>:</span>
          <input type="number" id="timerSecs" placeholder="Sec" min="0" max="59" style="width: 50px;">
          
          <button id="startTimerBtn">Start</button>
        </div>
        <hr>
        <div id="activeTimers">
          <p class="empty-msg">No active timers.</p>
        </div>
      </div>
    </div>

    <div class="header-center">
      <h1>Recipe Collection</h1>
    </div>
  
    <nav class="top-nav">
      <a href="/add-recipe" class="home-btn">+ Add Recipe</a>
    </nav>
  </header>

  <main>
    <section class="search-section">
      <div class="form-header">
        <h2>Find a Recipe</h2>
        <div class="search-container">
          <input type="text" id="recipeSearch" placeholder="Search presets (e.g. Apple)..." autocomplete="off">
          <ul id="searchResults" class="results-list hidden"></ul>
        </div>
      </div>
      <p id="help-text-home" style="font-size: 0.8rem; color: #666;">
        Type a keyword to search your saved presets. Press Enter or click the result to view. (IH#1 & IH#7)
      </p>
    </section>

    <hr>

    <section id="feed">
      </section>
  </main>

  <script src="/index.js"></script>
</body>
</html>